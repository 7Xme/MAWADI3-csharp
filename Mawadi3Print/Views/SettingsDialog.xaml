<UserControl x:Class="Mawadi3Print.Views.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:Mawadi3Print.ViewModels"
             xmlns:converters="clr-namespace:Mawadi3Print.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}"
             Width="450"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </UserControl.Resources>
    <materialDesign:DialogHost Identifier="SettingsDialog">
        <StackPanel Margin="24" FlowDirection="RightToLeft">
            <TextBlock Text="إعدادات مفتاح Gemini"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,16" />

            <TextBlock Text="مفتاح Google Gemini"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />

            <TextBlock FontSize="12"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       Margin="0,0,0,12">
                    <Hyperlink Command="{Binding OpenLinkCommand}"
                               NavigateUri="https://aistudio.google.com/app/apikey"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        https://aistudio.google.com/app/apikey
                    </Hyperlink>
            </TextBlock>

            <!-- Existing key status -->
            <Border Background="#E8F5E9"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasExistingKey, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircle"
                                             Foreground="Green"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ExistingKeyPreview}"
                               VerticalAlignment="Center"
                               FontSize="13" />
                    <Button Content="محي"
                            Foreground="Red"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ClearKeyCommand}"
                            Cursor="Hand"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Padding="4,0" />
                </StackPanel>
            </Border>

            <!-- New key input -->
            <TextBlock Text="مفتاح Gemini"
                       FontSize="13"
                       Margin="0,0,0,4" />
            <PasswordBox x:Name="KeyPasswordBox"
                         materialDesign:HintAssist.Hint="AIza..."
                         Margin="0,0,0,12"
                         materialDesign:PasswordBoxAssist.Password="{Binding NewKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="حفظ المفتاح"
                    Command="{Binding SaveKeyCommand}"
                    IsDefault="True"
                    Margin="0,0,0,8" />

            <TextBlock Text="خطأ:"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                       Foreground="Red"
                       FontSize="12"
                       Margin="0,0,0,8" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="12"
                       Margin="0,0,0,8" />

            <TextBlock Text="لمفتاح كايتبقى فهاد الجهاز فقط."
                       FontSize="11"
                       Foreground="Gray"
                       Margin="0,8,0,0" />

            <Button Content="غلق"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </materialDesign:DialogHost>
</UserControl>